# Keep the public company email readable without JavaScript during site reviews.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/privacy
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Preserve vinext's default caching for content-hashed assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
